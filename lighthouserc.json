{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-out.mjs 3200 --h2",
      "startServerReadyPattern": "serving out/",
      "url": [
        "https://localhost:3200/",
        "https://localhost:3200/c/data-visualization",
        "https://localhost:3200/p/contribution-heatmap",
        "https://localhost:3200/g/experience"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ],
        "chromeFlags": "--ignore-certificate-errors"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/c/).*$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.85
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.001
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 600
              }
            ],
            "resource-summary:font:size": [
              "error",
              {
                "maxNumericValue": 122880
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "localhost:3200/$",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 184320
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 1800
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "/(c|p|g)/",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "/c/",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.65
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.001
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 2000
              }
            ],
            "resource-summary:font:size": [
              "error",
              {
                "maxNumericValue": 122880
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 716800
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
