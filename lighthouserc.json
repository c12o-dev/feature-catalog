{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-out.mjs 3200",
      "startServerReadyPattern": "serving out/",
      "url": [
        "http://localhost:3200/",
        "http://localhost:3200/c/data-visualization",
        "http://localhost:3200/p/contribution-heatmap",
        "http://localhost:3200/g/experience"
      ],
      "numberOfRuns": 1,
      "settings": { "onlyCategories": ["performance", "accessibility", "best-practices", "seo"] }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 1800 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.001 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 122880 }]
          }
        },
        {
          "matchingUrlPattern": "localhost:3200/$",
          "assertions": { "resource-summary:script:size": ["error", { "maxNumericValue": 184320 }] }
        },
        {
          "matchingUrlPattern": "/c/",
          "assertions": { "resource-summary:script:size": ["error", { "maxNumericValue": 204800 }] }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
