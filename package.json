{
  "name": "feature-catalog",
  "version": "0.1.0",
  "private": true,
  "description": "モダン Web の「ユーザーから見える機能」を動くデモ付きで索引化したカタログ",
  "author": "Seu (https://c12o.net)",
  "license": "MIT",
  "homepage": "https://features.c12o.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/c12o-dev/feature-catalog.git"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "gen": "node scripts/gen-demos.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "dev": "node scripts/gen-demos.mjs && node scripts/build-fonts.mjs && next dev",
    "build": "node scripts/gen-demos.mjs && node scripts/build-fonts.mjs && next build && node scripts/inject-font-preloads.mjs",
    "preview": "wrangler pages dev out",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --project=smoke --project=a11y --project=stages --project=keyboard",
    "serve": "node scripts/serve-out.mjs",
    "shots": "playwright test --project=shots",
    "lhci": "lhci autorun",
    "checklist": "node scripts/demo-checklist.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run e2e && pnpm run lhci"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.11.0",
    "motion": "^12.38.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.74.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/shippori-mincho-b1": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
